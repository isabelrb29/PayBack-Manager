        <name>Validate Refund Amount</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

	//trocando vírgula por ponto
	var normalizedValue = newValue.replace(',','.');

   var amount = parseFloat(normalizedValue);

	//verificando se não é um número válido
   if(isNaN(amount)) {
	g_form.addErrorMessage('Please enter a valid number');
	g_form.setValue('refund_amount', '');
	return;
   }

   //verificando se o valor é menor ou igual a zero
   if(amount <= 0) {
	g_form.addErrorMessage('The amount must be greater than zero');
	g_form.setValue('refund_amount', '');
   } else {
	//remove as msg de erro anteriores se o valor estiver válido
	g_form.clearMessages();
	g_form.setValue('refund_amount', normalizedValue);
   }
   
}]]></script>
